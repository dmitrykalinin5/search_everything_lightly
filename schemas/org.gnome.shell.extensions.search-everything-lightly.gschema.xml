<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="search-everything-lightly">
  <schema id="org.gnome.shell.extensions.search-everything-lightly"
          path="/org/gnome/shell/extensions/search-everything-lightly/">
    <key name="toggle-search" type="as">
      <default>['&lt;Super&gt;Return']</default>
      <summary>Open or close file search</summary>
      <description>Global keyboard shortcut for Search Everything Lightly.</description>
    </key>
    <key name="show-file-manager-button" type="b">
      <default>true</default>
      <summary>Show the Files button</summary>
      <description>Show a button in the search field that opens the home folder.</description>
    </key>
  </schema>
</schemalist>
