msgid "Search apps and files..."
msgstr "Поиск приложений и файлов…"

msgid "GNOME LocalSearch is unavailable and plocate is not installed."
msgstr "GNOME LocalSearch недоступен, а plocate не установлен."

msgid "Masks and regular expressions require plocate.\nFedora: sudo dnf install plocate"
msgstr "Для масок и регулярных выражений требуется plocate.\nFedora: sudo dnf install plocate"

msgid "Could not launch this application."
msgstr "Не удалось запустить приложение."

msgid "The query is too long or contains an invalid character."
msgstr "Запрос слишком длинный или содержит недопустимый символ."

msgid "The regular expression is empty or invalid."
msgstr "Регулярное выражение пустое или содержит ошибку."

msgid "No matching files. The index may need updating."
msgstr "Ничего не найдено. Возможно, нужно обновить индекс."

msgid "The available file search indexes are unavailable or unreadable.\nSee the README for setup and permissions."
msgstr "Доступные поисковые индексы отсутствуют или недоступны для чтения.\nИнструкции по настройке и правам доступа — в README."

msgid "Search timed out. Try a more specific query."
msgstr "Время поиска истекло. Попробуйте уточнить запрос."

msgid "Search failed. Please try again."
msgstr "Ошибка поиска. Попробуйте ещё раз."

msgid "Opening…"
msgstr "Открытие…"

msgid "Could not open this location. It may have been removed or disconnected, or no application is available."
msgstr "Не удалось открыть объект. Возможно, он удалён, диск отключён или нет подходящего приложения."

msgid "Search"
msgstr "Поиск"

msgid "Keyboard shortcut"
msgstr "Горячая клавиша"

msgid "Super+Space may already switch keyboard layouts in GNOME. Choose another shortcut here if needed."
msgstr "Super+Space может быть занято переключением раскладки GNOME. При необходимости выберите другое сочетание здесь."

msgid "Open or close search"
msgstr "Открыть или закрыть поиск"

msgid "Change shortcut"
msgstr "Изменить сочетание"

msgid "Reset shortcut"
msgstr "Сбросить сочетание"

msgid "Search sources"
msgstr "Источники поиска"

msgid "GNOME LocalSearch updates ordinary home files automatically. Optional plocate adds hidden and system files."
msgstr "GNOME LocalSearch автоматически обновляет обычные файлы домашнего каталога. Необязательный plocate добавляет скрытые и системные файлы."

msgid "Primary source. Updates automatically without sudo updatedb."
msgstr "Основной источник. Обновляется автоматически без sudo updatedb."

msgid "Optional plocate"
msgstr "Необязательный plocate"

msgid "Installed for hidden and system files"
msgstr "Установлен для скрытых и системных файлов"

msgid "Not installed. Fedora: sudo dnf install plocate"
msgstr "Не установлен. Fedora: sudo dnf install plocate"

msgid "Refreshing hidden and system files"
msgstr "Обновление скрытых и системных файлов"

msgid "If plocate results are missing or stale, run sudo updatedb in a terminal. Ordinary LocalSearch results do not require it."
msgstr "Если результаты plocate отсутствуют или устарели, выполните sudo updatedb в терминале. Обычным результатам LocalSearch это не требуется."

msgid "Press a shortcut with Ctrl, Alt or Super.\nEscape cancels."
msgstr "Нажмите сочетание с Ctrl, Alt или Super.\nEscape — отмена."

msgid "Cancel"
msgstr "Отмена"
